{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.splunkdev.com/dashify/v1/elements/o11y-single-value.json",
  "title": "o11y:SingleValue",
  "description": "Configuration for the o11y:SingleValue dashboard element.",
  "type": "object",
  "properties": {
    "chart": {
      "$ref": "#/definitions/O11ySingleValueChartConfig"
    },
    "datasource": {
      "$ref": "#/definitions/O11ySignalFlowDatasourceConfig"
    },
    "widget": {
      "$ref": "#/definitions/O11yTemplateWidget"
    }
  },
  "required": ["chart", "datasource", "widget"],
  "additionalProperties": false,
  "definitions": {
    "O11ySingleValueChartConfig": {
      "type": "object",
      "properties": {
        "colorScale": {
          "$ref": "#/definitions/O11yColorScale"
        },
        "numberPrecision": {
          "type": "number",
          "deprecated": true,
          "description": "Use maximumFractionDigits instead."
        },
        "maxPrecision": {
          "type": "number",
          "deprecated": true,
          "description": "Use maximumSignificantDigits instead."
        },
        "maximumFractionDigits": {
          "type": "number"
        },
        "maximumSignificantDigits": {
          "type": "number"
        },
        "displayUnit": {
          "$ref": "#/definitions/O11yDisplayUnit"
        },
        "publishLabelOptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/O11yPublishLabelOption"
          },
          "deprecated": true,
          "description": "Use displayUnit instead."
        },
        "secondaryVisualization": {
          "type": "string",
          "enum": ["Linear", "None", "Radial", "Sparkline"]
        },
        "showTimestamp": {
          "type": "boolean"
        },
        "trendDisplay": {
          "type": "string",
          "enum": ["absolute", "percent", "off"]
        },
        "noDataOptions": {
          "$ref": "#/definitions/O11yNoDataOptions"
        }
      },
      "additionalProperties": false
    },
    "O11yColorScale": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/O11yColorScaleItem"
      }
    },
    "O11yColorScaleItem": {
      "type": "object",
      "properties": {
        "paletteIndex": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "hashKey": {
          "type": "string"
        },
        "gt": {
          "type": ["number", "null"]
        },
        "gte": {
          "type": ["number", "null"]
        },
        "lt": {
          "type": ["number", "null"]
        },
        "lte": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": false
    },
    "O11yDisplayUnit": {
      "anyOf": [
        {
          "$ref": "#/definitions/O11yScalingUnit"
        },
        {
          "$ref": "#/definitions/O11yDisplayUnitCustom"
        },
        {
          "type": "null"
        }
      ]
    },
    "O11yScalingUnit": {
      "type": "string",
      "enum": [
        "Bit",
        "Kilobit",
        "Megabit",
        "Gigabit",
        "Terabit",
        "Petabit",
        "Exabit",
        "Zettabit",
        "Yottabit",
        "Byte",
        "Kibibyte",
        "Mebibyte",
        "Gibibyte",
        "Tebibyte",
        "Pebibyte",
        "Exbibyte",
        "Zebibyte",
        "Yobibyte",
        "Nanosecond",
        "Microsecond",
        "Millisecond",
        "Second",
        "Minute",
        "Hour",
        "Day",
        "Week"
      ]
    },
    "O11yDisplayUnitCustom": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": ["string", "null"]
        },
        "suffix": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "O11yPublishLabelOption": {
      "type": "object",
      "properties": {
        "valuePrefix": {
          "type": "string"
        },
        "valueSuffix": {
          "type": "string"
        },
        "valueUnit": {
          "$ref": "#/definitions/O11yScalingUnit"
        }
      },
      "additionalProperties": false
    },
    "O11yNoDataOptions": {
      "type": "object",
      "properties": {
        "linkText": {
          "type": "string"
        },
        "linkUrl": {
          "type": "string"
        },
        "noDataMessage": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "O11ySignalFlowDatasourceConfig": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string"
        },
        "maxDelay": {
          "type": ["number", "null"]
        },
        "resolution": {
          "type": ["number", "null"]
        },
        "minimumResolution": {
          "type": ["number", "null"]
        },
        "sampleSize": {
          "type": "number"
        },
        "backfillSliceCount": {
          "type": "number"
        },
        "preferredEditor": {
          "type": "string"
        },
        "time": {
          "$ref": "#/definitions/O11yTimeRange"
        },
        "events": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "O11yTimeRange": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["absolute", "relative"]
        },
        "range": {
          "type": "number"
        },
        "rangeEnd": {
          "type": "number"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "O11yTemplateWidget": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "aiGenerated": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/O11yLink"
          }
        },
        "headerless": {
          "type": "boolean"
        },
        "borderless": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "O11yLink": {
      "type": "object",
      "properties": {
        "external": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    }
  }
}
